@Composable
fun PersonalLifeOSApp() {
    val overviewStats = listOf(
        "Owner" to "proshantobarman",
        "Project" to "Personal Life OS",
        "Focus" to "Intentional living",
        "Mode" to "Daily system"
    )

    val goals = listOf(
        "Build healthier routines",
        "Protect deep work time",
        "Reduce decision fatigue",
        "Stay consistent, not perfect"
    )

    val habits = listOf(
        "Morning planning: 15 min",
        "Exercise: 30 min",
        "Reading: 20 min",
        "Inbox reset: 10 min"
    )

    val dailyPlan = listOf(
        "06:30" to "Wake, stretch, hydrate",
        "08:00" to "Deep work sprint",
        "12:30" to "Lunch + reset",
        "18:00" to "Workout or walk",
        "21:00" to "Review, reflect, rest"
    )

    MaterialTheme(
        colorScheme = darkColorScheme(
            primary = Color(0xFF7DD3FC),
            secondary = Color(0xFF38BDF8),
            background = Color(0xFF07111D),
            surface = Color(0xFF0B1220),
            onPrimary = Color(0xFF04131D),
            onBackground = Color(0xFFE5EEF9),
            onSurface = Color(0xFFE5EEF9)
        )
    ) {
        Surface(color = MaterialTheme.colorScheme.background) {
            Box(
                modifier = Modifier
                    .fillMaxSize()
                    .background(
                        brush = Brush.verticalGradient(
                            colors = listOf(
                                Color(0xFF07111D),
                                Color(0xFF0B1220),
                                Color(0xFF111827)
                            )
                        )
                    )
            ) {
                LazyColumn(
                    modifier = Modifier
                        .fillMaxSize()
                        .padding(horizontal = 18.dp, vertical = 20.dp),
                    verticalArrangement = Arrangement.spacedBy(18.dp)
                ) {
                    item {
                        HeaderCard()
                    }

                    item {
                        HeroCard()
                    }

                    item {
                        Row(
                            modifier = Modifier.fillMaxWidth(),
                            horizontalArrangement = Arrangement.spacedBy(12.dp)
                        ) {
                            overviewStats.forEach { (label, value) ->
                                StatChip(label = label, value = value)
                            }
                        }
                    }

                    item {
                        SectionTitle("Top priorities")
                    }

                    item {
                        Card(
                            modifier = Modifier.fillMaxWidth(),
                            shape = RoundedCornerShape(22.dp),
                            colors = CardDefaults.cardColors(containerColor = Color(0x0F1628FF))
                        ) {
                            Column(
                                modifier = Modifier.padding(18.dp),
                                verticalArrangement = Arrangement.spacedBy(12.dp)
                            ) {
                                goals.forEach { goal ->
                                    Row(
                                        verticalAlignment = Alignment.CenterVertically,
                                        horizontalArrangement = Arrangement.spacedBy(12.dp)
                                    ) {
                                        Box(
                                            modifier = Modifier
                                                .size(10.dp)
                                                .clip(CircleShape)
                                                .background(Color(0xFF7DD3FC))
                                        )
                                        Text(
                                            text = goal,
                                            color = Color(0xFFB6C2D6),
                                            fontSize = 15.sp
                                        )
                                    }
                                }
                            }
                        }
                    }

                    item {
                        SectionTitle("Daily rhythm")
                    }

                    item {
                        Card(
                            modifier = Modifier.fillMaxWidth(),
                            shape = RoundedCornerShape(22.dp),
                            colors = CardDefaults.cardColors(containerColor = Color(0x0F1628FF))
                        ) {
                            Column(modifier = Modifier.padding(18.dp)) {
                                habits.forEach { habit ->
                                    Row(
                                        modifier = Modifier
                                            .fillMaxWidth()
                                            .padding(vertical = 8.dp),
                                        horizontalArrangement = Arrangement.SpaceBetween,
                                        verticalAlignment = Alignment.CenterVertically
                                    ) {
                                        Text(
                                            text = habit,
                                            color = Color(0xFFE5EEF9),
                                            fontSize = 15.sp
                                        )
                                        Box(
                                            modifier = Modifier
                                                .size(8.dp)
                                                .clip(CircleShape)
                                                .background(Color(0xFF38BDF8))
                                        )
                                    }
                                }
                            }
                        }
                    }

                    item {
                        SectionTitle("Today")
                    }

                    items(dailyPlan) { (time, activity) ->
                        Card(
                            modifier = Modifier.fillMaxWidth(),
                            shape = RoundedCornerShape(18.dp),
                            colors = CardDefaults.cardColors(containerColor = Color(0x0F1628FF))
                        ) {
                            Row(
                                modifier = Modifier
                                    .fillMaxWidth()
                                    .padding(horizontal = 18.dp, vertical = 15.dp),
                                horizontalArrangement = Arrangement.SpaceBetween,
                                verticalAlignment = Alignment.CenterVertically
                            ) {
                                Text(
                                    text = time,
                                    color = Color(0xFF7DD3FC),
                                    fontWeight = FontWeight.SemiBold,
                                    fontSize = 14.sp
                                )
                                Text(
                                    text = activity,
                                    color = Color(0xFFE5EEF9),
                                    fontSize = 14.sp,
                                    modifier = Modifier.fillMaxWidth(0.75f),
                                    textAlign = TextAlign.Start
                                )
                            }
                        }
                    }
                }
            }
        }
    }
}

@Composable
private fun HeaderCard() {
    Row(
        modifier = Modifier
            .fillMaxWidth()
            .clip(RoundedCornerShape(20.dp))
            .background(Color(0x0C1627FF))
            .padding(horizontal = 18.dp, vertical = 16.dp),
        verticalAlignment = Alignment.CenterVertically,
        horizontalArrangement = Arrangement.SpaceBetween
    ) {
        Row(verticalAlignment = Alignment.CenterVertically) {
            Box(
                modifier = Modifier
                    .size(42.dp)
                    .clip(RoundedCornerShape(12.dp))
                    .background(
                        brush = Brush.linearGradient(
                            colors = listOf(Color(0xFF7DD3FC), Color(0xFF93C5FD))
                        )
                    ),
                contentAlignment = Alignment.Center
            ) {
                Text(
                    text = "P",
                    color = Color(0xFF04131D),
                    fontWeight = FontWeight.ExtraBold,
                    fontSize = 20.sp
                )
            }

            Spacer(modifier = Modifier.size(12.dp))

            Column {
                Text(
                    text = "PERSONAL LIFE OS",
                    fontSize = 11.sp,
                    color = Color(0xFFB6C2D6),
                    letterSpacing = 1.sp
                )
                Text(
                    text = "Life dashboard",
                    fontSize = 24.sp,
                    fontWeight = FontWeight.Bold,
                    color = Color(0xFFE5EEF9)
                )
            }
        }

        Box(
            modifier = Modifier
                .clip(RoundedCornerShape(999.dp))
                .background(Color(0xFF7DD3FC).copy(alpha = 0.16f))
                .padding(horizontal = 12.dp, vertical = 8.dp)
        ) {
            Text(
                text = "Active",
                color = Color(0xFF7DD3FC),
                fontSize = 12.sp,
                fontWeight = FontWeight.SemiBold
            )
        }
    }
}

@Composable
private fun HeroCard() {
    Card(
        modifier = Modifier.fillMaxWidth(),
        shape = RoundedCornerShape(24.dp),
        colors = CardDefaults.cardColors(containerColor = Color(0xFF0F1C2B))
    ) {
        Column(modifier = Modifier.padding(20.dp)) {
            Box(
                modifier = Modifier
                    .clip(RoundedCornerShape(999.dp))
                    .background(Color(0xFF7DD3FC).copy(alpha = 0.12f))
                    .padding(horizontal = 12.dp, vertical = 8.dp)
            ) {
                Text(
                    text = "PUBLIC • PRODUCTIVE • FOCUSED",
                    color = Color(0xFF7DD3FC),
                    fontSize = 11.sp,
                    fontWeight = FontWeight.Bold,
                    letterSpacing = 1.sp
                )
            }

            Spacer(modifier = Modifier.height(14.dp))

            Text(
                text = "Build a clearer, more intentional life.",
                color = Color(0xFFE5EEF9),
                fontSize = 30.sp,
                lineHeight = 36.sp,
                fontWeight = FontWeight.Bold
            )

            Spacer(modifier = Modifier.height(12.dp))

            Text(
                text = "A personal system for goals, routines, habits, priorities, and the systems that help life feel calmer and more focused.",
                color = Color(0xFFB6C2D6),
                fontSize = 15.sp,
                lineHeight = 24.sp
            )

            Spacer(modifier = Modifier.height(18.dp))

            Row(horizontalArrangement = Arrangement.spacedBy(12.dp)) {
                PrimaryActionButton(label = "Explore")
                SecondaryActionButton(label = "Review")
            }
        }
    }
}

@Composable
private fun StatChip(label: String, value: String) {
    Card(
        modifier = Modifier.weight(1f),
        shape = RoundedCornerShape(18.dp),
        colors = CardDefaults.cardColors(containerColor = Color(0x0C1627FF))
    ) {
        Column(
            modifier = Modifier.padding(horizontal = 12.dp, vertical = 14.dp),
            horizontalAlignment = Alignment.Start
        ) {
            Text(
                text = label,
                color = Color(0xFFB6C2D6),
                fontSize = 11.sp,
                fontWeight = FontWeight.Medium
            )
            Spacer(modifier = Modifier.height(4.dp))
            Text(
                text = value,
                color = Color(0xFFE5EEF9),
                fontSize = 13.sp,
                fontWeight = FontWeight.SemiBold
            )
        }
    }
}

@Composable
private fun PrimaryActionButton(label: String) {
    Box(
        modifier = Modifier
            .clip(RoundedCornerShape(999.dp))
            .background(
                Brush.linearGradient(
                    colors = listOf(Color(0xFF7DD3FC), Color(0xFF38BDF8))
                )
            )
            .padding(horizontal = 18.dp, vertical = 12.dp),
        contentAlignment = Alignment.Center
    ) {
        Text(text = label, color = Color(0xFF04131D), fontWeight = FontWeight.Bold)
    }
}

@Composable
private fun SecondaryActionButton(label: String) {
    Box(
        modifier = Modifier
            .clip(RoundedCornerShape(999.dp))
            .background(Color.Transparent)
            .padding(horizontal = 18.dp, vertical = 12.dp)
    ) {
        Text(text = label, color = Color(0xFFE5EEF9), fontWeight = FontWeight.Bold)
    }
}

@Composable
private fun SectionTitle(title: String) {
    Text(
        text = title,
        color = Color(0xFFE5EEF9),
        fontSize = 18.sp,
        fontWeight = FontWeight.Bold
    )
}
